// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Modelo temporal para generar el cliente de Prisma
// Se eliminará cuando se implementen los modelos reales en BACK-003
model Temp {
  id Int @id @default(autoincrement())
}
