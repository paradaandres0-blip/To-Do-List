# URL base del backend (cambiar en producción)
# Cuando haya PostgreSQL + API, apunta aquí (ej. http://localhost:3000/api)
VITE_API_URL=http://localhost:3000/api

# Modo: "mock" usa datos simulados sin backend | "real" llama al backend
# Docentes: mock → teacherService en memoria | real → GET/POST/PUT/DELETE /teachers
VITE_AUTH_MODE=mock
