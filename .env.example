# ── API Configuration ──
VITE_API_URL=http://localhost:3000/api

# ── Authentication Mode ──
# Options: mock | real
VITE_AUTH_MODE=mock

# ── App Version ──
VITE_APP_VERSION=1.0.0

# ── Optional: Analytics ──
# VITE_ANALYTICS_ID=your-analytics-id

# ── Optional: Feature Flags ──
# VITE_ENABLE_NOTIFICATIONS=true
# VITE_ENABLE_REPORTS=true
# VITE_ENABLE_EXPORT=true